# CHA dunst - marka temali bildirim (hafif)
# ~/.config/dunst/dunstrc veya /etc/dunst/dunstrc.d/cha.conf
[global]
  font = Inter 10
  frame_width = 2
  frame_color = "#0FB5A6"
  separator_color = "#2A323A"
  corner_radius = 8
  background = "#10151A"
  foreground = "#F2F4F3"
  timeout = 5
  idle_threshold = 120
[urgency_low]
  background = "#1A2129"
  foreground = "#F2F4F3"
[urgency_normal]
  background = "#10151A"
  foreground = "#F2F4F3"
[urgency_critical]
  background = "#FFB224"
  foreground = "#10151A"
  frame_color = "#FFB224"
