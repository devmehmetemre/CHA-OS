[Icon Theme]
Name=chaOS-icons
Comment=CHA OS resmi ikon paketi — minimal, düz tasarım
Inherits=Papirus,hicolor
Example=folder

Directories=16x16/apps,16x16/categories,16x16/status,\
  22x22/apps,22x22/categories,22x22/status,\
  24x24/apps,24x24/categories,24x24/status,\
  32x32/apps,32x32/categories,32x32/status,\
  48x48/apps,48x48/categories,48x48/status,\
  64x64/apps,64x64/categories,\
  96x96/apps,\
  128x128/apps,\
  scalable/apps,scalable/categories,scalable/places,scalable/status

[16x16/apps]
Size=16
Context=Applications
Type=Fixed

[16x16/categories]
Size=16
Context=Categories
Type=Fixed

[16x16/status]
Size=16
Context=Status
Type=Fixed

