# CHA OS — Özel Hafifletilmiş Kernel Yapılandırması
# Alpine LTS kernel tabanlı, gereksiz modüller devre dışı
# Hedef: Düşük bellek tüketimi, hızlı açılış, uyumluluk

# ─── Temel Ayarlar ───────────────────────────────────────
CONFIG_LOCALVERSION="-chaos"
CONFIG_LOCALVERSION_AUTO=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_AUDIT=n                  # Güvenlik denetimi kapalı (masaüstü için)
CONFIG_NO_HZ_IDLE=y             # Güç tasarrufu için tickless
CONFIG_HZ_250=y                 # 250Hz timer (denge: tepki + güç)

# ─── İşlemci ─────────────────────────────────────────────
CONFIG_SMP=y                    # Çok çekirdek desteği
CONFIG_X86_64=y
CONFIG_GENERIC_CPU=y            # Genel CPU uyumu
CONFIG_CPU_FREQ=y               # CPU frekans ölçeklendirme
CONFIG_CPU_FREQ_GOV_ONDEMAND=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_MTRR=y
CONFIG_X86_MCE=y

# ─── Bellek ──────────────────────────────────────────────
CONFIG_MEMORY_HOTPLUG=n         # Gereksiz, hafifletmek için kaldırıldı
CONFIG_MEMORY_HOTREMOVE=n
CONFIG_KSM=y                    # Bellek tekilleştirme (VM'lerde faydalı)
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_ZSWAP=y                  # Sıkıştırılmış swap (düşük RAM için)
CONFIG_ZRAM=y
CONFIG_ZSMALLOC=y

# ─── Depolama ─────────────────────────────────────────────
CONFIG_BLK_DEV_SD=y             # SATA/SCSI
CONFIG_BLK_DEV_NVME=y           # NVMe SSD
CONFIG_ATA=y
CONFIG_ATA_PIIX=y
CONFIG_SATA_AHCI=y
CONFIG_EXT4_FS=y                # Ext4 (varsayılan dosya sistemi)
CONFIG_VFAT_FS=y                # FAT32 (EFI bölümü)
CONFIG_EXFAT_FS=y               # exFAT (USB sürücüler)
CONFIG_NTFS3_FS=y               # NTFS okuma/yazma
CONFIG_BTRFS_FS=m               # Btrfs modül olarak
CONFIG_XFS_FS=m

# ─── Dosya Sistemi ────────────────────────────────────────
CONFIG_TMPFS=y
CONFIG_TMPFS_XATTR=y
CONFIG_OVERLAY_FS=y             # Container/overlay desteği
CONFIG_SQUASHFS=y               # LiveISO için
CONFIG_SQUASHFS_LZ4=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_AUFS_FS=n                # AUFS yok, overlay kullanıyoruz

# ─── Ağ ──────────────────────────────────────────────────
CONFIG_NET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_NETFILTER=y              # Firewall
CONFIG_NF_TABLES=y              # nftables
CONFIG_BRIDGE=m                 # Köprü (VM/container)
CONFIG_WIRELESS=y
CONFIG_CFG80211=y               # Wi-Fi çerçevesi
CONFIG_MAC80211=y
CONFIG_RFKILL=y

# ─── USB ──────────────────────────────────────────────────
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y           # USB 3.x
CONFIG_USB_EHCI_HCD=y           # USB 2.0
CONFIG_USB_STORAGE=y
CONFIG_USB_HID=y

# ─── Grafik ──────────────────────────────────────────────
CONFIG_DRM=y                    # Direct Rendering
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_I915=m               # Intel GPU
CONFIG_DRM_AMDGPU=m             # AMD GPU
CONFIG_DRM_NOUVEAU=m            # NVIDIA (açık kaynak)
CONFIG_DRM_VIRTIO_GPU=y         # QEMU/VirtIO GPU
CONFIG_FB=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_LOGO=n                   # Tux logosu yok, bizimki var

# ─── Sanallaştırma ────────────────────────────────────────
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_KVM_GUEST=y
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y

# ─── Güvenlik ─────────────────────────────────────────────
CONFIG_SECURITY=y
CONFIG_SECURITY_SELINUX=n       # SELinux kapalı (hafiflik için)
CONFIG_SECURITY_APPARMOR=y      # AppArmor aktif
CONFIG_SECCOMP=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_SHA256=y
CONFIG_DM_CRYPT=y               # LUKS disk şifreleme

# ─── Devre Dışı Bırakılanlar (hafifletme) ─────────────────
CONFIG_HAMRADIO=n
CONFIG_ISDN=n
CONFIG_ATM=n
CONFIG_X25=n
CONFIG_LAPB=n
CONFIG_PHONET=n
CONFIG_IEEE802154=n
CONFIG_NFC=n
CONFIG_INFINIBAND=n
CONFIG_FDDI=n
CONFIG_HIPPI=n
CONFIG_PCMCIA=n
CONFIG_CARDBUS=n
CONFIG_STAGING=n
CONFIG_DEBUG_KERNEL=n
CONFIG_KGDB=n
CONFIG_FTRACE=n
